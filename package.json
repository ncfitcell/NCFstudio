{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply ncfvs-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply ncfvs-production",
    "db:console:local": "wrangler d1 execute ncfvs-production --local",
    "db:console:prod": "wrangler d1 execute ncfvs-production",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local"
  },
  "dependencies": {
    "hono": "^4.13.2",
    "@supabase/supabase-js": "^2.50.0"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
